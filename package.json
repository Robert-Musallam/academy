    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.5.6",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "10.1.8",
    "postcss": "8.4.31",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "3.4.19",
